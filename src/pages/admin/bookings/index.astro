---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import Screen from "./_components/screen";
import { UserRole } from "@/lib/utils/auth";
import { serverApiService, type ApiResponse } from "@/lib/utils/api";
import { CONSTANTS, ROUTES } from "@/lib/utils/constants";

// Check if user has permission (middleware already authenticated)
const currentUser = Astro.locals.user;
if (
  !currentUser ||
  (currentUser.role !== UserRole.SUPER_ADMIN &&
    currentUser.role !== UserRole.HOTEL_ADMIN)
) {
  return Astro.redirect("/admin/dashboard");
}

// Get effective hotel ID for filtering
const effectiveHotelId =
  currentUser.role === UserRole.HOTEL_ADMIN ? currentUser.hotelId : null;

// Fetch bookings from API
let bookings: any[] = [];

if (effectiveHotelId) {
  // If hotel admin, fetch bookings for specific hotel
  const bookingsResponse: ApiResponse<any> = await serverApiService.get(
    `/api/v1/bookings/hotel/${effectiveHotelId}`,
    Astro.cookies.get(CONSTANTS.ACCESS_TOKEN_KEY)?.value || "",
    Astro.cookies,
  );
  bookings = bookingsResponse.success ? bookingsResponse.data.bookings : [];
} else {
  // For super admin, fetch all bookings
  // This would typically be a separate API endpoint
  // For now, we'll use mock data or fetch from a general endpoint
  const bookingsResponse: ApiResponse<any> = await serverApiService.get(
    "/api/v1/bookings",
    Astro.cookies.get(CONSTANTS.ACCESS_TOKEN_KEY)?.value || "",
    Astro.cookies,
  );
  bookings = bookingsResponse.success ? bookingsResponse.data.bookings : [];
}

// Sort bookings: confirmed first, then by booking/creation date (latest bookings first)
if (bookings && Array.isArray(bookings)) {
  bookings.sort((a: any, b: any) => {
    // First priority: confirmed bookings come first
    if (a.status === 'confirmed' && b.status !== 'confirmed') return -1;
    if (a.status !== 'confirmed' && b.status === 'confirmed') return 1;
    
    // Second priority: sort by booking date (latest bookings first)
    // Try bookingDate, createdAt, or fallback to checkInDate
    const dateA = new Date(a.bookingDate || a.createdAt || a.checkInDate).getTime();
    const dateB = new Date(b.bookingDate || b.createdAt || b.checkInDate).getTime();
    return dateB - dateA;
  });
}

console.log("bookings are ", bookings);
---

<DashboardLayout title="Bookings">
  <Screen bookings={bookings} user={currentUser} client:load />
</DashboardLayout>
